@//E*O*F makefile//
chmod u=rw,g=r,o=r makefile
 
echo x - polytree.c
sed 's/^@//' > "polytree.c" <<'@//E*O*F polytree.c//'
/* Copyright Paul Callahan (call...@crabcake.cs.jhu.edu), 1990.
   Permission to copy and modify is granted, as
   long as you leave this header comment.
   [If you come up with a nicer way to output the strips, or 
    any other improvements, please send me a copy] */
#include <stdio.h>
#define MAXARRAY 100
#define polyr 270
#define disp 30
#define pageheight 750
#define pagewidth 560

/* polytree.c: generates PostScript picture of the polygon 
   triangulation corresponding to a binary tree structure.

        (and draws the tree structure inside, comments
         on how this is done are omitted)

   Tree structure is specified in RPN.  
       "." is the empty tree.
       "t" is an operation which forms a new tree from the
           two trees which precede it.

   Accepts an arbitrarily long sequence of tree descriptions,
   each on a separate line. 
*/

main()
{
int done,vertnum,polysize,stacktop,listtail,inputnode;
struct {int first,middle,last,lchildmid,rchildmid;}
                        stack[MAXARRAY],
                        edgelist[MAXARRAY],
                        treebound;
int i,px,py,maxpx,maxpy;

/* Postfix evaluation is done in standard manner, using a stack.
   As edges are generated, they are appended to a list.  
   (Note that we can't draw an edge till we know the size of the
    polygon).
*/
/* output is supposed to be PostScript */

   printf("%%!\n");

   /* Now do some PostScript magic */
   printf("0.5 setlinewidth\n");
   printf("/Helvetica findfont 8 scalefont setfont\n");
   printf("/polygon {/n exch def /rad exch def /y exch def /x exch def} def\n");
   printf("/makeedge {gsave newpath findvert moveto findvert lineto\n"); 
   printf("           0.25 setlinewidth [1 1.2] 0 setdash\n");
   printf("           stroke grestore} def\n"); 
   printf("/findvert {0.5 add n div 360 mul 90 add /theta exch def\n");  
   printf("           theta cos rad mul x add\n");  
   printf("           theta sin rad mul y add} def\n"); 
   printf("/labvert {/rad rad 10 add def findvert /rad rad 10 sub def\n");
   printf("          moveto show} def\n"); 
   printf("/maketreearc {/D exch def /C exch def /B exch def /A exch def\n");
   printf("              A B C midpt 2 copy dot moveto\n"); 
   printf("              B C D midpt 2 copy dot lineto stroke} def\n");
   printf("/midpt {findvert /y3 exch def /x3 exch def\n"); 
   printf("        findvert /y2 exch def /x2 exch def\n"); 
   printf("        findvert /y1 exch def /x1 exch def\n"); 
   printf("        x1 x2 add x3 add 3 div\n");
   printf("        y1 y2 add y3 add 3 div\n");
   printf("       } def\n");
   printf("/dot {gsave newpath currentlinewidth 3 mul\n");
   printf("      0 360 arc fill grestore} def\n");

 maxpx=(pagewidth/polyr)/2-1;
 maxpy=(pageheight/polyr)/2-1;

 px=0; py=0;
 done=0;
 while (!done) {
   stacktop=0;
   listtail=0;
   vertnum=0;

   while (((inputnode=getchar())!=EOF)&&(inputnode!=(int)'\n')) {
     switch((char)inputnode) {
         case '.':

          /* empty tree is just an outside edge on the polygon */

           treebound.first=vertnum;
           treebound.last= ++vertnum;
           treebound.middle= -1; /* no middle vertex */
           stack[stacktop++]=treebound;
           edgelist[listtail++]=treebound;
         break;

         case 't': 
           if (stacktop<2) printf("%% Stack Underflow\n");
           else {

           /* new polygon is formed by connecting first and
              last vertices of two preceding polygons */

               treebound.last      = stack[--stacktop].last;
               treebound.rchildmid = stack[stacktop].middle;
               treebound.middle    = stack[stacktop].first;

               treebound.lchildmid = stack[--stacktop].middle;
               treebound.first     = stack[stacktop].first;

               stack[stacktop++]=treebound; 
               edgelist[listtail++]=treebound;
           }
         break;

         default:
            printf("%%\'%c\' ignored\n",(char)inputnode);
     }
   }
   if (inputnode==EOF) done=1; 
   else {
     /* stack should now have exactly one element */
     if (stacktop>1) printf("%% Incomplete tree string\n");

     /* Size of polygon is maximum vertex number + 1 */
     polysize=vertnum+1; 

     printf("%d %d %d %d polygon\n",px*2*polyr+polyr+disp,
                                    py*2*polyr+polyr+disp,polyr*92/100,
                                    polysize);

     for (i=0; i<polysize; i++) printf("(%d) %d labvert\n",i,i);

     while(listtail>0) {
       --listtail;
       printf("%d %d makeedge\n",edgelist[listtail].first,
                                 edgelist[listtail].last);

       if (edgelist[listtail].middle!= -1)  {
          if (edgelist[listtail].lchildmid!= -1) 
                printf("%d %d %d %d maketreearc\n",
                       edgelist[listtail].last,
                       edgelist[listtail].middle,
                       edgelist[listtail].first,
                       edgelist[listtail].lchildmid);
  
          if (edgelist[listtail].rchildmid!= -1) 
                printf("%d %d %d %d maketreearc\n",
                       edgelist[listtail].first,
                       edgelist[listtail].middle,
                       edgelist[listtail].last,
                       edgelist[listtail].rchildmid);
       }

     }
     px++; 
     if (px>maxpx) {
        px=0;
        py++;
        if (py>maxpy) {
          printf("gsave\nshowpage\ngrestore\n");
          py=0;
        }
     }  
   }
 } 
 if ((px!=0) || (py!=0)) printf("showpage\n");
}
@//E*O*F polytree.c//
chmod u=rw,g=r,o=r polytree.c
 
exit 0
